# Copy to .env and fill in. Local and production use the same values.

# Neon Postgres
DATABASE_URL=

# Readwise (highlights export; only books tagged @share are published)
READWISE_ACCESS_TOKEN=

# Single API key for the JSON API routes under /api (external consumers)
API_KEY=

# Buttondown newsletter
BUTTONDOWN_API_KEY=

# Vercel cron: auto-provisioned in production. Any random string locally.
CRON_SECRET=

# Better Auth (magic link admin login). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Only this email can request a magic link and sign in
ADMIN_EMAIL=

# Resend (magic link emails). From address must be a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket, full URL with scheme, no trailing slash, e.g. https://media.example.com
R2_PUBLIC_URL=

# Plausible analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_SRC=
